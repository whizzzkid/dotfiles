[user]
  name = Nishant Arora
  email = 1895906+whizzzkid@users.noreply.github.com
  signingkey = ssh-ed25519 
[core]
  autocrlf = input
  whitespace = fix,space-before-tab,tab-in-indent,trailing-space
  excludesfile = ~/.gitignore_global
  editor = nano
[apply]
  whitespace = fix
[alias]
  br = branch
  ci = commit
  co = checkout
  df = diff
  g = grep -I
  lg = log -p
  pp = !"echo 'Pull'; git pull; echo 'Push'; git push"
  rb = rbranch
  rv = review
  st = status
  fpush = push
  stash = stash
  unstash = stash
  nvc = commit
  wtt = "!f() { path=\"worktrees/$1\"; git worktree add --track -b \"$1\" \"$path\" origin/$1; WT=\"$path\" ./worktree.sh; }; f"
  wtb = "!f() { path=\"worktrees/$1\"; git worktree add -b \"$1\" \"$path\" \"${2:-main}\"; WT=\"$path\" ./worktree.sh; }; f"
  wta = "!f() { path=\"worktrees/$1\"; git worktree add \"$path\" \"$1\"; WT=\"$path\" ./worktree.sh; }; f"
  wtr = "!f() { path=\"worktrees/$1\"; git worktree remove \"$path\"; }; f"
  wtl = "!f() { git worktree list; }; f"
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[merge]
  log = true
	tool = cursor
[rerere]
  enabled = true
  autoUpdate = true
[url "git@github.com:"]
  insteadOf = "gh:"
  pushInsteadOf = "github:"
  pushInsteadOf = "git://github.com/"
[url "git://github.com/"]
  insteadOf = "github:"
[url "git@gist.github.com:"]
  insteadOf = "gst:"
  pushInsteadOf = "gist:"
  pushInsteadOf = "git://gist.github.com/"
[url "git://gist.github.com/"]
  insteadOf = "gist:"
[url "git@heroku.com:"]
  insteadOf = "heroku:"
[commit]
  gpgsign = true
  verbose = true
[gpg]
  format = ssh
[pull]
  rebase = true
  ff = only
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[init]
  defaultBranch = main
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[fetch]
  writeCommitGraph = true
[branch]
  sort = -committerdate
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
	tool = cursor
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = true
  all = true
[help]
  autocorrect = prompt
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[difftool "cursor"]
	cmd = cursor --wait --diff
[mergetool "cursor"]
	cmd = cursor --wait $MERGED
[maintenance]
	repo = /Users/nishant.arora/gitc/gusto/web
